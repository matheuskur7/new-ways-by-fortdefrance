// ============================================================================
// Configuração do Prisma
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Usuários e autenticação
// ============================================================================

model User {
  id                   String         @id
  name                 String
  email                String         @unique
  emailVerified        Boolean        @default(false)
  deletedAt            DateTime?      @map("deleted_at")
  image                String?
  sessions             Session[]
  accounts             Account[]
  memberships          Member[]
  invitations          Invitation[]
  createdCustomers     Customer[]     @relation("CustomerCreatedBy")
  updatedCustomers     Customer[]     @relation("CustomerUpdatedBy")
  createdUsers         User[]         @relation("UserCreatedBy")
  updatedUsers         User[]         @relation("UserUpdatedBy")
  createdOrganizations Organization[] @relation("OrganizationCreatedBy")
  updatedOrganizations Organization[] @relation("OrganizationUpdatedBy")
  createdMembers       Member[]       @relation("MemberCreatedBy")
  updatedMembers       Member[]       @relation("MemberUpdatedBy")
  createdInvitations   Invitation[]   @relation("InvitationCreatedBy")
  updatedInvitations   Invitation[]   @relation("InvitationUpdatedBy")
  createdImages        Image[]        @relation("ImageCreatedBy")
  updatedImages        Image[]        @relation("ImageUpdatedBy")
  createdCardFeeGroups CardFeeGroup[] @relation("CardFeeGroupCreatedBy")
  updatedCardFeeGroups CardFeeGroup[] @relation("CardFeeGroupUpdatedBy")
  createdCardFees      CardFee[]      @relation("CardFeeCreatedBy")
  updatedCardFees      CardFee[]      @relation("CardFeeUpdatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  creator   User?    @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater   User?    @relation("UserUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([createdBy])
  @@index([updatedBy])
  @@map("auth_user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("auth_session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verification")
}

// ============================================================================
// Empresas, membros e convites
// ============================================================================

model Organization {
  id          String       @id
  name        String
  slug        String       @unique
  logo        String?
  metadata    String?
  members     Member[]
  invitations Invitation[]
  customers   Customer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  creator   User?    @relation("OrganizationCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater   User?    @relation("OrganizationUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([createdBy])
  @@index([updatedBy])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String       @default("member")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  creator   User?    @relation("MemberCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater   User?    @relation("MemberUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("organization_member")
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  creator   User?    @relation("InvitationCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater   User?    @relation("InvitationUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([email])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("organization_invitation")
}

// ============================================================================
// Clientes
// ============================================================================

model Customer {
  id             String       @id @default(uuid(7)) @db.Uuid
  name           String       @db.VarChar(255)
  cpfCnpj        String       @map("cpf_cnpj") @db.VarChar(14)
  phone          String       @db.VarChar(20)
  type           CustomerType
  organizationId String       @map("organization_id")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  creator   User?    @relation("CustomerCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater   User?    @relation("CustomerUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@unique([organizationId, cpfCnpj])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("customer")
}

enum CustomerType {
  PERSON
  COMPANY
}

// ============================================================================
// Imagens
// ============================================================================

model Image {
  id             String  @id @default(uuid(7)) @db.Uuid
  tag            String  @db.VarChar(100)
  key            String  @db.VarChar(255)
  userId         String? @map("user_id") @db.Uuid
  serviceOrderId String? @map("service_order_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  creator   User?    @relation("ImageCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater   User?    @relation("ImageUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([tag])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("image")
}

// ============================================================================
// Taxas de cartão
// ============================================================================

model CardFeeGroup {
  id           String    @id @default(cuid())
  seedKey      String?   @unique
  name         String
  channel      String
  displayOrder Int       @default(100)
  logoSvg      String?   @db.Text
  rates        CardFee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  creator   User?    @relation("CardFeeGroupCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater   User?    @relation("CardFeeGroupUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([createdBy])
  @@index([updatedBy])
}

model CardFee {
  id           String       @id @default(cuid())
  groupId      String
  group        CardFeeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  installments Int
  ratePercent  Decimal      @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  creator   User?    @relation("CardFeeCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater   User?    @relation("CardFeeUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@unique([groupId, installments])
  @@index([createdBy])
  @@index([updatedBy])
}
