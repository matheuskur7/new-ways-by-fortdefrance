# Backend e PostgreSQL
NODE_ENV=development
PORT=5000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=backend_nestjs
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/backend_nestjs
FRONTEND_URL=http://localhost:3000

# S3: informe ambas as chaves ou deixe ambas vazias para usar a cadeia padrão AWS.
S3_REGION=us-east-1
S3_ENDPOINT=
S3_KEY_ID=
S3_KEY_SECRET=
S3_BUCKET=example-images
S3_FORCE_PATH_STYLE=false
S3_URL_TTL_SECONDS=300
MAX_IMAGE_SIZE_BYTES=10485760

# Variáveis existentes, opcionais; módulos de autenticação/seed/email ainda não implementados.
JWT_SECRET=
JWT_EXPIRES_IN=
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=
ADMIN_USER_NAME=
ADMIN_USER_PASSWORD=
ADMIN_USER_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
