# Backend e PostgreSQL
NODE_ENV=development
PORT=5000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=backend_nestjs
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/backend_nestjs
FRONTEND_URL=http://localhost:3000

# S3: informe ambas as chaves ou deixe ambas vazias para usar a cadeia padrão AWS.
S3_REGION=us-east-1
S3_ENDPOINT=
S3_KEY_ID=
S3_KEY_SECRET=
S3_BUCKET=example-images
S3_FORCE_PATH_STYLE=false
S3_URL_TTL_SECONDS=300
MAX_IMAGE_SIZE_BYTES=10485760

# Better Auth: URL pública do backend e segredo obrigatório de pelo menos 32 caracteres.
# Gere seu segredo local com: openssl rand -base64 48
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Variáveis legadas/reservadas; JWT separado não está implementado.
JWT_SECRET=
JWT_EXPIRES_IN=
# Conta inicial: preencha os três campos antes de pnpm db:seed.
# A senha deve ter entre 8 e 128 caracteres. Contas existentes são preservadas.
ADMIN_USER_NAME=
ADMIN_USER_PASSWORD=
ADMIN_USER_EMAIL=

# E-mail via Nodemailer/SMTP. Sem host e credenciais, o envio fica indisponível.
SMTP_HOST=
# Porta 465 usa TLS direto: SMTP_SECURE=true.
# Porta 587 usa STARTTLS obrigatório: SMTP_SECURE=false.
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="New Ways <nao-responda@example.com>"
SMTP_REPLY_TO=suporte@example.com
