# Backend
PORT=5000
DATABASE_URL="postgresql://user:password@localhost:5432/database_name"
JWT_SECRET="secret"
JWT_EXPIRES_IN='time_in_seconds'
# Usuário inicial (seed): a senha é usada apenas ao criar uma conta nova
ADMIN_USER_NAME="Admin User"
ADMIN_USER_EMAIL="admin@example.com"
ADMIN_USER_PASSWORD="replace-with-a-strong-password"

# Cloud
S3_REGION=us-east-1
S3_ENDPOINT=
S3_KEY_ID=
S3_KEY_SECRET=
S3_BUCKET=

# Better Auth (generate secret with: openssl rand -base64 48)
BETTER_AUTH_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# SMTP Hostinger: preencha o usuário e a senha da caixa de e-mail.
# Porta 465: SMTP_SECURE=true; porta 587: false (STARTTLS obrigatório).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="New Ways <nao-responda@fortdefrance.com.br>"
SMTP_REPLY_TO=
